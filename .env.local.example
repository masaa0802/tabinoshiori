# ブログ（microCMS）用の環境変数テンプレート
#
# このファイルをコピーして .env.local を作り、値を埋める。
#   cp .env.local.example .env.local
#
# .env.local はコミットしないこと（.gitignore の `.env*` で除外済み）。
# APIキーの取得・設定手順は docs/MICROCMS_SETUP.md を参照。

# microCMS のサービスID。管理画面URL https://<ここ>.microcms.io の部分
MICROCMS_SERVICE_DOMAIN=

# microCMS の API キー（GET 権限があれば足りる）
MICROCMS_API_KEY=

# microCMS の webhook 署名検証用シークレット
# 管理画面 > API設定 > Webhook で「カスタム通知」を作るときに設定した値
MICROCMS_WEBHOOK_SECRET=

# 下書きの画面プレビュー用のシークレット（任意）
# microCMS の APIキーではなく、こちらで決める任意の文字列。
# 設定しないとプレビュー機能そのものが無効になる（/api/preview が404を返す）。
#
# microCMS の API設定 → 画面プレビュー に入れるURL:
#   https://tabinoshiori.jp/api/preview?secret=<この値>&contentId={CONTENT_ID}&draftKey={DRAFT_KEY}
MICROCMS_PREVIEW_SECRET=

# サイトの公開URL（OGP・sitemap・RSS の絶対URL生成に使う）
# 未設定時は https://tabinoshiori.jp にフォールバックする
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 宿の予約アフィリエイト（しおり画面の「空室・料金を見る」ボタン）
# どれも未設定なら予約ボタンは表示されない。リンクに出る公開値なので NEXT_PUBLIC_ で良い。
# 本番は Netlify の環境変数に設定し、再デプロイで反映する。詳しくは docs/AFFILIATE.md
# Trip.com アフィリエイト（管理画面で作ったリンクの Allianceid / SID）
NEXT_PUBLIC_TRIPCOM_ALLIANCE_ID=
NEXT_PUBLIC_TRIPCOM_SID=
# バリューコマース: サイトID（sid）と、提携した広告主ごとのプログラムID（pid）
NEXT_PUBLIC_VC_SID=
NEXT_PUBLIC_VC_PID_JALAN=
NEXT_PUBLIC_VC_PID_YAHOO_TRAVEL=
NEXT_PUBLIC_VC_PID_IKYU=

# 予約確認のスクショ・PDFの自動読み取り（/api/extract-booking）で使う Claude API のキー
# サーバー側だけで使うので NEXT_PUBLIC_ を付けないこと。未設定なら読み取りは行わず手入力のまま
ANTHROPIC_API_KEY=
